# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Every local dist dir (NEXT_TEST_DIST_DIR): .next-e2e, .next-build-check, ...
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# test artifacts
/playwright-report/
/test-results/
/.playwright-mcp/
.neon

# Local review material and source artwork; keep out of application commits.
/tmp/
/public/*.psd
/public/images/demo/freitas-qa-oculos.webp
# public/images/demo/review-*.webp (generated by scripts/seed-review-data.ts) are versioned on purpose
# while the public site is a demo; they leave with `pnpm db:remove:review` before launch (docs/decisions.md).

# Read-only demo walkthrough (pnpm test:demo)
/playwright-report-demo/
/test-results-demo/

# Local git worktrees
.claude/worktrees/

# Local review screenshots and work queues from the Claude chats
.claude/fila-*/
.claude/t13/
