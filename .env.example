# Core database and authentication (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"
BETTER_AUTH_SECRET="generate-a-random-secret-with-at-least-32-characters"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
ADMIN_EMAILS="admin@example.com"

# Checkout providers (optional until checkout is enabled)
MERCADO_PAGO_ACCESS_TOKEN=""
# Public Key (not Access Token), from the same application/environment.
MERCADO_PAGO_PUBLIC_KEY=""
# Optional per-payment webhook URL; use HTTPS and configure the matching secret.
MERCADO_PAGO_NOTIFICATION_URL=""
MERCADO_PAGO_API_URL="https://api.mercadopago.com"
# Reserved for a future homologated 1:N adapter; this flag does not enable split today.
MERCADO_PAGO_MULTI_SELLER_ENABLED="false"
MERCADO_PAGO_WEBHOOK_SECRET=""
# OAuth do Sandbox: o redirect_uri precisa ser idêntico ao callback cadastrado
# no app. Local e Preview têm origens diferentes; não use o callback de Produção
# durante os testes locais.
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
MELHOR_ENVIO_REDIRECT_URI=""
# Base64 de 32 bytes, exclusivo para criptografar tokens de lojistas.
MELHOR_ENVIO_TOKEN_ENCRYPTION_KEY=""
MELHOR_ENVIO_API_URL="https://sandbox.melhorenvio.com.br"
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=""
MELHOR_ENVIO_USER_AGENT="O Moto Shop (suporte@motoshopbrasil.com.br)"

# Observability (optional locally)
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Inngest (optional when using the local dev server)
# Local only: INNGEST_DEV=1. Do not enable Dev Mode on a public deployment.
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Upstash Redis (optional until a Redis-backed feature is enabled)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ImageKit Forever Free (required for product and store image uploads)
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# Resend (optional until transactional email is enabled)
RESEND_API_KEY=""
EMAIL_FROM="O Moto Shop <no-reply@example.com>"

# Review demo data (scripts/seed-review-data.ts). Optional; leave empty outside review sessions.
# Shared password of every review.*@example.test account. Required by the review seed and by pnpm test:demo;
# the seed rewrites it on every run. Never commit the real value.
REVIEW_ACCOUNTS_PASSWORD=""
# Database hosts where seed and removal scripts may run (comma-separated). Local hosts are always allowed;
# any other host is refused unless listed here, so a copied .env.local never seeds or wipes the wrong database.
SCRIPT_DATABASE_HOSTS=""
# "true" publishes the demo stores (default keeps them PENDING and invisible).
REVIEW_PUBLISH_STORES=""
# Comma-separated e-mails of EXISTING accounts that receive a fictitious customer history
# (addresses, saved motorcycles, favorites, cart, orders MS-REVIEW-V<n>-*). Never created or changed.
REVIEW_VIEWER_CUSTOMER_EMAILS=""
# Comma-separated e-mails of EXISTING accounts added as ADMIN of the demo store "Garagem MX"
# (skipped when the account already belongs to another store).
REVIEW_VIEWER_SELLER_EMAILS=""
# Comma-separated e-mails of accounts the demo removal scripts must never delete (the client's and the
# support account). Both removal scripts refuse to run while it is empty.
DEMO_REMOVAL_PROTECTED_EMAILS=""
