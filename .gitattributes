# Normalize every text file to LF in the repository and in working copies (Windows included),
# so Prettier, diffs and CI agree regardless of core.autocrlf.
* text=auto eol=lf

# Binary assets: never normalized or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.psd binary
*.woff binary
*.woff2 binary
*.pdf binary
