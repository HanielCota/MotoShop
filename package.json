{
  "name": "motoshop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3005",
    "dev:review": "next dev --hostname localhost --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:seed:review": "tsx scripts/seed-review-data.ts",
    "db:remove:review": "tsx scripts/remove-review-data.ts",
    "db:review:clean-texts": "tsx scripts/review-clean-texts.ts",
    "db:hide:review": "tsx scripts/hide-review-stores.ts",
    "db:review:shipping": "tsx scripts/review-shipping-nationwide.ts",
    "inngest:dev": "pnpm dlx inngest-cli@1.46.0 dev"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/prisma-adapter": "1.7.12",
    "@hookform/resolvers": "^6.0.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nextjs": "11.9.0",
    "@tanstack/react-table": "9.3.1",
    "@upstash/redis": "1.39.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.0",
    "date-fns": "^4.4.0",
    "inngest": "4.26.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "nuqs": "^2.10.2",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "resend": "6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@neon/config": "1.9.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "^18.0.9",
    "jsdom": "30.1.3",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "react-email": "6.11.3",
    "shadcn": "4.22.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.10.1"
}
